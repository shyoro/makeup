# Local development only. Copy to .env (gitignored) and fill in.
# Production values live in Cloudflare Worker secrets, never in this repo.
#
# Contact-form recipient. Comma-separated list. The Worker FAILS LOUDLY if
# unset — there is deliberately no fallback recipient. See spec section 4.
CONTACT_TO=

# Verified sender. Until the domain is verified this is Resend's dev sender.
MAIL_FROM=

# Resend API key.            secret in production
RESEND_API_KEY=

# Google AI Studio key for Gemini Flash.   secret in production
GEMINI_API_KEY=

# Gemini model id.           plain env var, not a secret
GEMINI_MODEL=

# Sanity. projectId and dataset are PUBLIC by design (CDN reads).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=
