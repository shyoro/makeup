---
// Portfolio as a scroll story: full-screen photo scenes and text sections
// take turns, so the page moves between pictures and words as she scrolls,
// with photo pairs in between. Block order comes from data.
import type { PortfolioSection, StoryBlock } from '../../lib/sanity/types';
import Pair from './story/Pair.astro';
import Scene from './story/Scene.astro';
import TextPanel from './story/TextPanel.astro';

interface Props {
  section: PortfolioSection;
}

const { section } = Astro.props;

// Scenes alternate the colour they wash into; text sections alternate the
// turn of the flowers behind them (the heading section takes the first).
const TONES = ['blush', 'peach'] as const;
const TURNS = [90, 180] as const;
const alternate = <T,>(pair: readonly [T, T], i: number): T =>
  i % 2 === 0 ? pair[0] : pair[1];
let scenes = 0;
let texts = 1;
const blocks = section.blocks.map((block: StoryBlock) => ({
  block,
  tone: alternate(TONES, block._type === 'scene' ? scenes++ : 0),
  turn: alternate(TURNS, block._type === 'text' ? texts++ : 0),
}));
---

<section data-scene="portfolio" class="relative">
  <TextPanel flowers={section.flowers} turn={TURNS[0]}>
    <h2 class="font-display text-5xl leading-none md:text-7xl">
      {section.title}
    </h2>
    {section.intro && (
      <p class="mt-4 text-lg leading-relaxed text-ink-muted md:text-xl">
        {section.intro}
      </p>
    )}
    {section.startingPrice && (
      <p class="mt-2 text-ink-muted">
        איפור כלה החל מ־<span dir="ltr">{section.startingPrice} ₪</span>
      </p>
    )}
  </TextPanel>

  {blocks.map(({ block, tone, turn }) => {
    if (block._type === 'scene')
      return <Scene media={block.media} tone={tone} />;
    if (block._type === 'pair') return <Pair items={block.items} />;
    return (
      <TextPanel flowers={section.flowers} turn={turn}>
        <h3 class="font-display text-4xl leading-tight md:text-6xl">
          {block.title}
        </h3>
        <p class="mt-4 text-lg leading-relaxed text-ink-muted md:text-xl">
          {block.body}
        </p>
      </TextPanel>
    );
  })}
</section>
