---
// Portfolio as a scroll story: full-screen photo scenes and text sections
// take turns, so the page moves between pictures and words as she scrolls,
// with photo pairs in between and a closing action at the end. Block order
// comes from data; how each text section is laid out is decided here.
import { displayPhone, telHref } from '../../lib/phone';
import type { PortfolioSection, StoryBlock } from '../../lib/sanity/types';
import InkFilter from './story/InkFilter.astro';
import Pair from './story/Pair.astro';
import Scene from './story/Scene.astro';
import TextPanel from './story/TextPanel.astro';

interface Props {
  section: PortfolioSection;
}

const { section } = Astro.props;

type Align = 'start' | 'end' | 'center';
type Place = `${'top' | 'bottom'}-${'start' | 'end'}`;

const alternate = <T,>(pair: readonly [T, T], i: number): T =>
  i % 2 === 0 ? pair[0] : pair[1];

// Text sections, the heading first, take turns: words to one side and then
// the other (statement lines and the closing are centred), flowers in the
// opposite corner, turned 90° then 180°. After a photo (or her painting, for
// the heading) the flowers grow from the bottom, so they never lie over the
// picture as it leaves; otherwise from the top.
let texts = 0;
let sides = 0;
function textLayout(centred: boolean, afterPicture: boolean) {
  const t = texts++;
  const align: Align = centred
    ? 'center'
    : alternate(['start', 'end'] as const, sides++);
  const block = afterPicture ? 'bottom' : 'top';
  const inline =
    align === 'center'
      ? alternate(['start', 'end'] as const, t)
      : align === 'start'
        ? 'end'
        : 'start';
  return {
    align,
    place: `${block}-${inline}` satisfies Place,
    // Centred words leave room only at the sides: the upright quarter turn.
    turn: align === 'center' ? 90 : alternate([90, 180] as const, t),
  };
}

const heading = textLayout(false, true);
// Scenes alternate the colour they wash into.
let scenes = 0;
const story = section.blocks.map((block: StoryBlock, i) => {
  const afterPicture = section.blocks[i - 1]?._type === 'scene';
  switch (block._type) {
    case 'scene':
      return {
        ...block,
        tone: alternate(['blush', 'peach'] as const, scenes++),
      };
    case 'pair':
      return block;
    case 'text':
      return {
        ...block,
        layout: textLayout(Boolean(block.statement), afterPicture),
      };
    case 'closing':
      return { ...block, layout: textLayout(true, afterPicture) };
  }
});

const body = 'mt-4 text-lg leading-relaxed text-pretty text-ink md:text-xl';
---

{/* Rises over the opening's last stretch: see --role-scene-overlap. */}
<section data-scene="portfolio" class="relative -mt-scene-overlap">
  <InkFilter />
  <TextPanel flowers={section.flowers} {...heading}>
    <h2 class="font-display text-5xl leading-none text-balance md:text-7xl">
      {section.title}
    </h2>
    {section.intro && <p class={body}>{section.intro}</p>}
    {section.startingPrice && (
      <p class="mt-4 text-lg text-pretty text-ink md:text-xl">
        איפור כלה החל מ־<span dir="ltr">{section.startingPrice} ₪</span>
      </p>
    )}
  </TextPanel>

  {story.map((block) => {
    if (block._type === 'scene')
      return <Scene media={block.media} tone={block.tone} />;
    if (block._type === 'pair') return <Pair items={block.items} />;
    if (block._type === 'closing')
      return (
        <TextPanel flowers={section.flowers} {...block.layout} drawIn>
          <div data-closing>
            <h3 class="font-display text-5xl leading-tight text-balance md:text-7xl">
              {block.title}
            </h3>
            <p class={body}>{block.body}</p>
            <a
              href={block.action.href}
              class="mt-8 inline-flex min-h-14 min-w-60 items-center justify-center rounded-card bg-accent px-8 text-lg text-on-accent transition-opacity hover:opacity-90"
            >
              {block.action.label}
            </a>
            {block.phone && (
              <p class="mt-4 text-lg text-ink-muted">
                <a
                  data-phone
                  dir="ltr"
                  href={telHref(block.phone)}
                  class="underline-offset-4 hover:underline"
                >
                  {displayPhone(block.phone)}
                </a>
              </p>
            )}
          </div>
        </TextPanel>
      );
    return (
      <TextPanel flowers={section.flowers} {...block.layout}>
        <h3
          class:list={[
            'font-display text-balance',
            block.statement
              ? 'text-6xl leading-none md:text-8xl'
              : 'text-5xl leading-tight md:text-7xl',
          ]}
        >
          {block.title}
        </h3>
        <p class={body}>{block.body}</p>
      </TextPanel>
    );
  })}
</section>
