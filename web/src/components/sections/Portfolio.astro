---
// Portfolio scene: each photo opens through an arch as it scrolls into view
// and settles from a slight zoom, while a vine keeps growing down the
// inline-end edge — the opening bouquet carrying on.
import type { PortfolioSection } from '../../lib/sanity/types';
import Media from '../media/Media.astro';
import { placeholderShape } from './bouquet/pieces';

interface Props {
  section: PortfolioSection;
}

const { section } = Astro.props;

// The vine is drawn in a 20 × 200 box stretched to the scene's full height;
// blooms are nested SVGs placed by percentage so they never stretch.
// 24 alternating bends, so it still winds when stretched over a tall scene.
const BENDS = 24;
const VINE = Array.from({ length: BENDS }, (_, i) => {
  const y0 = (i / BENDS) * 200;
  const y1 = ((i + 1) / BENDS) * 200;
  const side = i % 2 === 0 ? 2 : 18;
  return `C${side} ${y0 + 2} ${side} ${y1 - 2} 10 ${y1}`;
}).reduce((d, seg) => `${d} ${seg}`, 'M10 0');
const vineBlooms = [
  { kind: 'leaf', tone: 'fill-flower-leaf', y: '20%', rotate: -40, at: 0.25 },
  { kind: 'rose', tone: 'fill-flower-pink', y: '36%', rotate: 8, at: 0.4 },
  { kind: 'leaf', tone: 'fill-flower-leaf', y: '59%', rotate: 50, at: 0.6 },
  { kind: 'bud', tone: 'fill-flower-purple', y: '75%', rotate: -12, at: 0.75 },
] as const;
---

<section data-scene="portfolio" class="relative overflow-hidden py-section">
  <svg
    data-vine
    class="pointer-events-none absolute inset-y-0 end-0 h-full w-10 overflow-visible md:w-16"
    aria-hidden="true"
  >
    <svg
      viewBox="0 0 20 200"
      preserveAspectRatio="none"
      width="100%"
      height="100%"
    >
      <path
        d={VINE}
        class="fill-transparent stroke-flower-line"
        stroke-width="1"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
      />
    </svg>
    {vineBlooms.map((b) => {
      const shape = placeholderShape(b.kind);
      return (
        <svg
          data-vine-bloom
          data-at={b.at}
          viewBox="-25 -25 50 50"
          x="0"
          y={b.y}
          width="100%"
          height="64"
          class="overflow-visible"
        >
          <g transform={`rotate(${b.rotate})`}>
            {shape.fills.map((d) => (
              <path d={d} class={b.tone} />
            ))}
            {shape.highlights.map((d) => (
              <path
                d={d}
                class="fill-transparent stroke-surface"
                stroke-width="2.6"
                stroke-linecap="round"
                opacity="0.85"
              />
            ))}
          </g>
        </svg>
      );
    })}
  </svg>

  <div class="relative pe-14 ps-6 md:pe-24 md:ps-16">
    <h2 class="font-display text-5xl leading-none md:text-7xl">
      {section.title}
    </h2>
    {section.intro && (
      <p class="mt-4 max-w-prose text-lg leading-relaxed text-ink-muted">
        {section.intro}
      </p>
    )}
    {section.startingPrice && (
      <p class="mt-2 text-ink-muted">
        איפור כלה החל מ־<span dir="ltr">{section.startingPrice} ₪</span>
      </p>
    )}

    <div class="mt-12 grid items-start gap-10 md:grid-cols-2 md:gap-x-12 md:gap-y-0">
      {section.items.map((item, i) => (
        <div data-reveal class:list={[i % 2 === 1 && 'md:mt-32']}>
          <Media
            media={item}
            sizes="(min-width: 768px) 45vw, 85vw"
            class="w-full rounded-t-full"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from '../../lib/motion/gsap';

  // Arch: an inset clip whose top corners are fully rounded, opening upward.
  const CLOSED = 'inset(100% 0% 0% 0% round 999px 999px 0px 0px)';
  const OPEN = 'inset(0% 0% 0% 0% round 999px 999px 0px 0px)';

  for (const scene of document.querySelectorAll<HTMLElement>(
    '[data-scene="portfolio"]',
  )) {
    for (const wrap of scene.querySelectorAll<HTMLElement>('[data-reveal]')) {
      const img = wrap.querySelector('img');
      gsap.set(wrap, { clipPath: CLOSED });
      gsap.set(img, { scale: 1.1 });
      gsap
        .timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: wrap,
            start: 'top 85%',
            end: 'center center',
            scrub: 0.6,
          },
        })
        .to(wrap, { clipPath: OPEN }, 0)
        .to(img, { scale: 1 }, 0);
    }

    const vine = scene.querySelector('[data-vine] path');
    const blooms = [
      ...scene.querySelectorAll<SVGSVGElement>('[data-vine-bloom] > g'),
    ];
    gsap.set(vine, { drawSVG: '0%' });
    gsap.set(blooms, { opacity: 0, scale: 0, svgOrigin: '0 0' });
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: scene,
        start: 'top 80%',
        end: 'bottom bottom',
        scrub: 0.6,
      },
    });
    tl.to(vine, { drawSVG: '100%', duration: 1 }, 0);
    for (const bloom of blooms) {
      const at = Number(
        bloom.closest<SVGSVGElement>('[data-vine-bloom]')?.dataset.at,
      );
      tl.to(
        bloom,
        { opacity: 1, scale: 1, duration: 0.1, ease: 'back.out(1.6)' },
        at,
      );
    }
  }
</script>
