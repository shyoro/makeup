---
// Opening scene: her name on a shaded-white screen, and a bouquet that grows
// up from the bottom as she scrolls. No call to action here (spec §2).
import type { HeroSection } from '../../lib/sanity/types';
import Bouquet from './bouquet/Bouquet.astro';

interface Props {
  section: HeroSection;
}

const { section } = Astro.props;
---

<section data-scene="hero" class="relative h-svh overflow-hidden bg-surface">
  <div data-powder aria-hidden="true">
    <div class="absolute bottom-1/4 -start-16 size-64 rounded-full bg-powder-peach opacity-50 blur-3xl"></div>
    <div class="absolute bottom-8 -end-12 size-56 rounded-full bg-powder-lilac opacity-30 blur-3xl"></div>
    <div class="absolute top-1/3 start-1/3 size-40 rounded-full bg-blush opacity-30 blur-3xl"></div>
  </div>

  <Bouquet
    pieces={section.bouquet}
    class="absolute bottom-0 start-0 w-full md:h-5/6 md:w-auto"
  />

  <div class="relative ps-6 pt-16 md:ps-16 md:pt-24">
    {/* mt-4 is what tests/wave1/tokens.spec.ts's source-glob test reads off the
        first h1 on /. Keep it on this heading. */}
    <h1 class="font-display mt-4 text-6xl leading-none md:text-8xl">
      {section.name}
    </h1>
    <p class="mt-3 text-lg text-ink-muted md:text-xl">{section.subtitle}</p>
  </div>

  {section.scrollCue && (
    <p class="absolute bottom-6 end-6 text-sm text-ink-muted">
      {section.scrollCue} ↓
    </p>
  )}
</section>

<script>
  import { gsap } from '../../lib/motion/gsap';

  for (const scene of document.querySelectorAll<HTMLElement>(
    '[data-scene="hero"]',
  )) {
    const lines = scene.querySelectorAll('[data-lines] path');
    const accents = scene.querySelectorAll('[data-accents] > *');
    const pieces = [...scene.querySelectorAll<SVGGElement>('[data-piece]')];
    const powder = scene.querySelectorAll('[data-powder] > *');

    // Starting states are set here, never in markup, so no-JS shows it grown.
    gsap.set(lines, { drawSVG: '0%' });
    gsap.set(accents, { opacity: 0 });
    gsap.set(pieces, { opacity: 0 });
    gsap.set(
      pieces.map((p) => p.querySelector('[data-bloom]')),
      { scale: 0, svgOrigin: '0 0' },
    );

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: scene,
        start: 'top top',
        end: '+=150%',
        pin: true,
        scrub: 0.6,
        onRefresh: (self) => {
          scene.dataset.end = String(Math.round(self.end));
        },
      },
    });

    tl.to(lines, { drawSVG: '100%', duration: 0.7, stagger: 0.02 }, 0);
    tl.to(accents, { opacity: 1, duration: 0.05, stagger: 0.025 }, 0.5);
    for (const piece of pieces) {
      const at = Number(piece.dataset.at);
      tl.to(piece, { opacity: 1, duration: 0.06 }, at);
      tl.to(
        piece.querySelector('[data-bloom]'),
        { scale: 1, duration: 0.1, ease: 'back.out(1.6)' },
        at,
      );
    }
    tl.to(powder, { yPercent: -18, xPercent: 6, duration: 1 }, 0);
  }
</script>
