---
// Her ink drawing, turned a quarter or half turn, growing along the spray from
// one corner of its text section as it scrolls into view (or, at the end of
// the story where scroll runs out, drawing itself like the opening), bleeding
// off the side of the screen and clear of the words. Drawn in ink by InkFilter.astro over the CDN's
// black-and-white version. Decorative only.
import type { MediaImage, SanityImageRef } from '../../../lib/sanity/types';
import Media from '../../media/Media.astro';

interface Props {
  image: SanityImageRef;
  turn: 90 | 180;
  place: 'top-start' | 'top-end' | 'bottom-start' | 'bottom-end';
  drawIn?: boolean;
}

const { image, turn, place, drawIn = false } = Astro.props;
const top = place.startsWith('top');
const start = place.endsWith('start');

const media: MediaImage = {
  kind: 'image',
  alt: '',
  aspectRatio: 'editorial',
  image,
};
---

<div
  class:list={[
    'absolute inset-0 flex',
    top ? 'items-start' : 'items-end',
    start ? 'justify-start' : 'justify-end',
  ]}
  aria-hidden="true"
>
  <div
    data-flowers
    data-draw-in={drawIn || undefined}
    class:list={[
      // Clips the sweep window to the spray, so nothing of it (its feathered
      // edge included) shows beyond the drawing.
      'relative aspect-editorial shrink-0 overflow-hidden opacity-60',
      // A half turn lies wide and can grow larger than an upright quarter.
      turn === 90 ? 'w-4/5 rotate-90 md:w-1/2' : 'w-full rotate-180 md:w-3/5',
      // Inside the section top to bottom (its edge would cut them mid-
      // screen), bleeding off the side of the screen.
      top ? 'mt-12 md:mt-32' : 'mb-12 md:mb-32',
      start ? '-ms-16' : '-me-16',
    ]}
  >
    <div data-wipe="line" class="absolute inset-0 overflow-hidden">
      <div class="absolute inset-0">
        <Media
          media={media}
          fit="contain"
          mono
          widths={[800, 1200, 1600, 2000]}
          sizes="(min-width: 768px) 60vw, 100vw"
          class="size-full"
        />
      </div>
    </div>
  </div>
</div>

<style>
  /* On Media's own box, not the moving layer, so the filter is drawn once
     into that layer rather than on every frame of the sweep. */
  [data-flowers] :global([data-media]) {
    filter: url(#flowers-ink);
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '../../../lib/motion/gsap';
  import { pictureBeside } from '../../../lib/motion/story';
  import { createSweep } from '../../../lib/motion/sweep';

  for (const box of document.querySelectorAll<HTMLElement>('[data-flowers]')) {
    const win = box.querySelector<HTMLElement>('[data-wipe]');
    const panel = box.closest<HTMLElement>('[data-panel]');
    if (!win || !panel) continue;
    // A feathered edge, which only reads over the plain surface: so it grows
    // only once any photo before it has gone, and is done before the words
    // hand over to a photo after it (TextPanel.astro).
    const sweep = createSweep(box, win, { edge: 'feather' });
    const state = { p: 0 };
    const render = () => sweep.render(state.p);
    sweep.layout();
    render();
    ScrollTrigger.addEventListener('refresh', () => {
      sweep.layout();
      render();
    });
    // How long a self-drawing spray takes, in seconds; as the opening's.
    const DRAW_IN = 1.8;
    if (box.hasAttribute('data-draw-in')) {
      ScrollTrigger.create({
        trigger: panel,
        // Once the photo before it has all but gone.
        start: 'top 5%',
        once: true,
        onEnter: () => {
          gsap.to(state, {
            p: 1,
            duration: DRAW_IN,
            ease: 'power1.inOut',
            onUpdate: render,
          });
        },
      });
      continue;
    }
    // In terms of its section: a picture before it has gone once the
    // section fills the screen (its top at 0), and the hand-off to a photo
    // after it starts as the section's top passes -5%. Between two pictures
    // it takes the stretch in between, starting once the photo is mostly gone.
    const afterPicture = pictureBeside(panel, 'before');
    const beforePicture = pictureBeside(panel, 'after');
    let start = afterPicture ? 'top top' : 'top 60%';
    if (afterPicture && beforePicture) start = 'top 15%';
    const end = beforePicture ? 'top -5%' : 'top -40%';
    gsap.to(state, {
      p: 1,
      ease: 'none',
      onUpdate: render,
      scrollTrigger: {
        trigger: panel,
        start,
        end,
        scrub: 0.5,
      },
    });
  }
</script>
