---
// Her ink drawing in black and white, turned a quarter or half turn, growing
// along the spray as its text section scrolls through. Decorative only.
import type { MediaImage, SanityImageRef } from '../../../lib/sanity/types';
import Media from '../../media/Media.astro';

interface Props {
  image: SanityImageRef;
  turn: 90 | 180;
}

const { image, turn } = Astro.props;

const media: MediaImage = {
  kind: 'image',
  alt: '',
  aspectRatio: 'editorial',
  image,
};
---

<div
  class="absolute inset-0 flex items-center justify-center"
  aria-hidden="true"
>
  <div
    data-flowers
    class:list={[
      'relative aspect-editorial w-3/2 shrink-0 opacity-25 md:w-1/2',
      turn === 90 ? 'rotate-90' : 'rotate-180',
    ]}
  >
    <div data-wipe="line" class="absolute inset-0 overflow-hidden">
      <div class="absolute inset-0">
        <Media
          media={media}
          fit="contain"
          mono
          widths={[800, 1200, 1600]}
          sizes="(min-width: 768px) 50vw, 150vw"
          class="size-full"
        />
      </div>
    </div>
  </div>
</div>

<script>
  import { gsap, ScrollTrigger } from '../../../lib/motion/gsap';
  import { createSweep } from '../../../lib/motion/sweep';

  for (const box of document.querySelectorAll<HTMLElement>('[data-flowers]')) {
    const win = box.querySelector<HTMLElement>('[data-wipe]');
    if (!win) continue;
    const sweep = createSweep(box, win);
    const state = { p: 0 };
    const render = () => sweep.render(state.p);
    sweep.layout();
    render();
    ScrollTrigger.addEventListener('refresh', () => {
      sweep.layout();
      render();
    });
    gsap.to(state, {
      p: 1,
      ease: 'none',
      onUpdate: render,
      scrollTrigger: {
        trigger: box.closest('[data-panel]') ?? box,
        // Grows while it is on screen: from 40% up until it fills the screen.
        start: 'top 60%',
        end: 'top top',
        scrub: 0.5,
      },
    });
  }
</script>
