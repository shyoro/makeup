---
// Redraws her line art in the ink colour, the site's black: thicken the
// strokes a touch, drop the faintest alpha (scan grain) and strengthen the
// rest, then flood with ink inside them. Rendered once by Portfolio.astro; Flowers.astro
// points at it by id. The flood takes the ink token through currentColor.
---

<svg aria-hidden="true" class="absolute size-0 text-ink">
  <filter id="flowers-ink" color-interpolation-filters="sRGB">
    <feMorphology
      in="SourceAlpha"
      operator="dilate"
      radius="0.5"
      result="bold"
    ></feMorphology>
    <feComponentTransfer in="bold" result="strokes">
      <feFuncA type="linear" slope="2.5" intercept="-0.3"></feFuncA>
    </feComponentTransfer>
    <feFlood flood-color="currentColor"></feFlood>
    <feComposite in2="strokes" operator="in"></feComposite>
  </filter>
</svg>
