---
// A text section that scrolls over the full-screen photos, with her flowers
// growing beside the words. The words rise in as the section arrives and,
// when a photo comes next, words and flowers dissolve as it fades in.
import type { SanityImageRef } from '../../../lib/sanity/types';
import Flowers from './Flowers.astro';

interface Props {
  flowers?: SanityImageRef;
  turn: 90 | 180;
  /** Where the words sit across the page; phones keep them at the start. */
  align: 'start' | 'end' | 'center';
  /** Which corner the flowers grow from, clear of the words. */
  place: 'top-start' | 'top-end' | 'bottom-start' | 'bottom-end';
  /** The flowers draw themselves once in view, instead of with scroll. */
  drawIn?: boolean;
}

const { flowers, turn, align, place, drawIn = false } = Astro.props;
---

<div
  data-panel
  class:list={[
    'relative z-10 flex min-h-svh items-center overflow-hidden px-6 py-section md:px-16',
    align === 'end' && 'md:justify-end',
    align === 'center' && 'justify-center text-center',
  ]}
>
  {flowers && (
    <Flowers image={flowers} turn={turn} place={place} drawIn={drawIn} />
  )}
  <div data-panel-text class="relative max-w-prose">
    <slot />
  </div>
</div>

<script>
  import { gsap } from '../../../lib/motion/gsap';
  import { pictureBeside } from '../../../lib/motion/story';

  for (const panel of document.querySelectorAll<HTMLElement>('[data-panel]')) {
    const text = panel.querySelector('[data-panel-text]');
    // Starting state is set here, never in markup, so no-JS shows the text.
    gsap.fromTo(
      text,
      { autoAlpha: 0, y: 40 },
      {
        autoAlpha: 1,
        y: 0,
        ease: 'power1.out',
        scrollTrigger: {
          trigger: text,
          start: 'top 90%',
          end: 'top 60%',
          scrub: 0.5,
        },
      },
    );
    // Hand over to the next photo: words and flowers out as it fades in, and
    // quicker, so they are gone before the photo is strong enough to fight
    // them (Scene.astro times it by its top, which is this panel's bottom).
    if (pictureBeside(panel, 'after'))
      gsap.fromTo(
        panel.children,
        { autoAlpha: 1, y: 0 },
        {
          // Lifting as it goes also keeps it on its own layer while it fades.
          autoAlpha: 0,
          y: -40,
          ease: 'none',
          immediateRender: false,
          scrollTrigger: {
            trigger: panel,
            start: 'bottom 95%',
            end: 'bottom 70%',
            scrub: 0.5,
          },
        },
      );
  }
</script>
