---
// The page is its sections[], in data order (parent spec §8). Content is the
// mock for now; a GROQ query returning the same Page shape replaces it.
// The first h1 on / must carry mt-4 — see Hero.astro.
import RootLayout from '../layouts/RootLayout.astro';
import SectionRenderer from '../components/sections/SectionRenderer.astro';
import { mockPage } from '../lib/sanity/mock-page';
---

<RootLayout
  title="נועה לוי · איפור כלות"
  description="איפור כלות וערב בעבודת יד, מהפגישה הראשונה ועד הריקוד האחרון."
>
  <main>
    <SectionRenderer sections={mockPage.sections} />
  </main>
</RootLayout>
